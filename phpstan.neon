includes:
    - phpstan-baseline.neon

parameters:
    level: 9
    paths:
        - src
        - performance
        - tests/Stubs
    tmpDir: build/phpstan
    # Standalone cross-runtime experiment loads generated baseline classes and
    # runtime C FFI symbols. Validate it through output parity and smoke runs.
    excludePaths:
        analyse:
            - performance/comparison
    treatPhpDocTypesAsCertain: false
    checkPhpDocMissingReturn: true

    ignoreErrors:
        - identifier: missingType.iterableValue
        - '#Method .+ should return .+ but returns mixed#'
